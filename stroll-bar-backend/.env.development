NODE_ENV=development
PORT=3000
DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=strollbar
DB_SSL=false
JWT_SECRET=strollbar-dev-access-secret
JWT_ACCESS_TOKEN_TTL=1h
JWT_REFRESH_SECRET=strollbar-dev-refresh-secret
JWT_REFRESH_TOKEN_TTL=7d
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
AUTH_EXPOSE_RESET_TOKEN=true
DB_MIGRATIONS_RUN=false
S3_REGION=auto
S3_ENDPOINT=https://your-s3-compatible-endpoint
S3_BUCKET_NAME=strollbar-media
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key
S3_PUBLIC_BASE_URL=https://cdn.example.com/strollbar-media
S3_FORCE_PATH_STYLE=false
S3_PRESIGN_EXPIRES_SECONDS=900
MEDIA_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
MEDIA_ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/webm,video/quicktime
MEDIA_MAX_IMAGE_SIZE_BYTES=10485760
MEDIA_MAX_VIDEO_SIZE_BYTES=104857600
MEDIA_MULTIPART_THRESHOLD_BYTES=26214400
MEDIA_MULTIPART_PART_SIZE_BYTES=10485760
MEDIA_MULTIPART_MAX_PARTS=1000
