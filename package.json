{
  "name": "strollbar",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["stroll-bar-backend", "stroll-bar-frontend"],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev:backend:bootstrap": "node ./scripts/dev-backend-bootstrap.mjs",
    "db:up": "docker compose -f docker-compose.postgres.yml up -d",
    "db:up:local": "docker compose -f docker-compose.local-postgres.yml up -d",
    "db:down": "docker compose -f docker-compose.postgres.yml down",
    "db:down:local": "docker compose -f docker-compose.local-postgres.yml down",
    "db:reset": "docker compose -f docker-compose.postgres.yml down -v",
    "db:reset:local": "docker compose -f docker-compose.local-postgres.yml down -v",
    "db:logs": "docker compose -f docker-compose.postgres.yml logs -f postgres",
    "db:logs:local": "docker compose -f docker-compose.local-postgres.yml logs -f postgres",
    "db:migrate": "npm --workspace stroll-bar-backend run migration:run",
    "db:migrate:revert": "npm --workspace stroll-bar-backend run migration:revert",
    "start:backend": "npm --workspace stroll-bar-backend run start:dev",
    "start:frontend": "npm --workspace stroll-bar-frontend run start",
    "build:backend": "npm --workspace stroll-bar-backend run build",
    "build:frontend": "npm --workspace stroll-bar-frontend run build"
  }
}
